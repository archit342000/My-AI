# Allowlisted package proxy for the code runner sandbox: nginx with fixed upstreams only
# (PyPI, files.pythonhosted.org, registry.npmjs.org). It holds no secrets and mounts nothing.
FROM nginxinc/nginx-unprivileged:1.30.6-alpine

# Replaces the base config, so the stock conf.d/default.conf is not loaded.
COPY docker/pkg-proxy/nginx.conf /etc/nginx/nginx.conf

EXPOSE 8080
